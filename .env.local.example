# Mistral API (cloud or local)
MISTRAL_API_KEY=
# Optional: override base URL (default is https://api.mistral.ai/v1)
# For local/server deployments, point this to your own OpenAI-compatible endpoint, e.g.:
# MISTRAL_API_URL=http://localhost:8000/v1

# Vault encryption (set on first run or use a strong passphrase)
ENCRYPTION_PASSPHRASE=

# Optional: ElevenLabs voice (Phase 9 stretch)
ELEVENLABS_API_KEY=
